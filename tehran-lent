:root {
    --color-primary: #ef2b2d;
    --color-primary-dark: #c8181b;
    --color-dark: #0b0e13;
    --color-dark-2: #141922;
    --color-dark-3: #1d232e;
    --color-text: #171a20;
    --color-muted: #6d727d;
    --color-border: #e4e6ea;
    --color-surface: #ffffff;
    --color-background: #f5f6f8;
    --color-success: #23b26d;
    --color-warning: #f4b740;

    --shadow-small: 0 8px 25px rgba(14, 18, 25, 0.07);
    --shadow-medium: 0 20px 60px rgba(14, 18, 25, 0.12);
    --shadow-large: 0 35px 90px rgba(0, 0, 0, 0.25);

    --radius-small: 12px;
    --radius-medium: 20px;
    --radius-large: 30px;

    --container: 1220px;
    --header-height: 78px;
}

*,
*::before,
*::after {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
    scroll-padding-top: 100px;
}

body {
    margin: 0;
    color: var(--color-text);
    background: var(--color-surface);
    font-family: "Vazirmatn", Tahoma, sans-serif;
    line-height: 1.8;
    -webkit-font-smoothing: antialiased;
}

body.no-scroll {
    overflow: hidden;
}

button,
input,
textarea,
select {
    font: inherit;
}

button,
a {
    -webkit-tap-highlight-color: transparent;
}

button {
    cursor: pointer;
}

a {
    color: inherit;
    text-decoration: none;
}

img,
svg {
    display: block;
    max-width: 100%;
}

.container {
    width: min(calc(100% - 40px), var(--container));
    margin-inline: auto;
}

.sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    white-space: nowrap;
    clip: rect(0, 0, 0, 0);
    border: 0;
}

.skip-link {
    position: fixed;
    z-index: 9999;
    top: 10px;
    right: 10px;
    padding: 10px 18px;
    color: #fff;
    background: var(--color-primary);
    border-radius: 8px;
    transform: translateY(-150%);
    transition: transform 0.2s ease;
}

.skip-link:focus {
    transform: translateY(0);
}

/* Topbar */

.topbar {
    color: #d9dce2;
    background: #080a0e;
    font-size: 0.78rem;
}

.topbar__inner {
    min-height: 36px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
}

.topbar p,
.topbar__links {
    margin: 0;
    display: flex;
    align-items: center;
    gap: 9px;
}

.topbar a {
    transition: color 0.2s ease;
}

.topbar a:hover {
    color: #fff;
}

.status-dot {
    width: 7px;
    height: 7px;
    display: inline-block;
    flex: 0 0 auto;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 0 5px rgba(35, 178, 109, 0.12);
}

.separator {
    width: 1px;
    height: 14px;
    background: rgba(255, 255, 255, 0.18);
}

/* Header */

.site-header {
    position: sticky;
    z-index: 1000;
    top: 0;
    color: #fff;
    background: rgba(11, 14, 19, 0.94);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    backdrop-filter: blur(18px);
}

.header__inner {
    min-height: var(--header-height);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 30px;
}

.brand {
    display: inline-flex;
    align-items: center;
    gap: 12px;
}

.brand__mark {
    position: relative;
    width: 45px;
    height: 45px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 14px;
    background: linear-gradient(145deg, var(--color-primary), #a90c10);
    box-shadow: 0 8px 25px rgba(239, 43, 45, 0.28);
    transform: skewX(-7deg);
}

.brand__mark::before,
.brand__mark::after,
.brand__mark span {
    content: "";
    position: absolute;
    width: 23px;
    height: 5px;
    border-radius: 6px;
    background: #fff;
}

.brand__mark::before {
    transform: translateY(-9px);
}

.brand__mark::after {
    width: 17px;
    transform: translate(-3px, 9px);
}

.brand__mark span {
    width: 20px;
    transform: translateX(2px);
}

.brand__content {
    display: flex;
    flex-direction: column;
    line-height: 1.35;
}

.brand__content strong {
    color: #fff;
    font-size: 1.12rem;
    font-weight: 900;
}

.brand__content small {
    color: #aeb4bf;
    font-size: 0.67rem;
}

.desktop-nav {
    display: flex;
    align-items: center;
    gap: 31px;
}

.desktop-nav a {
    position: relative;
    color: #c6cad2;
    font-size: 0.88rem;
    font-weight: 500;
    transition: color 0.2s ease;
}

.desktop-nav a::after {
    content: "";
    position: absolute;
    right: 0;
    bottom: -10px;
    width: 0;
    height: 2px;
    background: var(--color-primary);
    transition: width 0.2s ease;
}

.desktop-nav a:hover,
.desktop-nav a.active {
    color: #fff;
}

.desktop-nav a:hover::after,
.desktop-nav a.active::after {
    width: 100%;
}

.header__actions {
    display: flex;
    align-items: center;
    gap: 9px;
}

.icon-button,
.menu-button {
    width: 43px;
    height: 43px;
    display: grid;
    place-items: center;
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 12px;
}

.icon-button svg {
    width: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
}

.cart-button {
    min-height: 43px;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 0 13px;
    color: #fff;
    background: var(--color-primary);
    border: 0;
    border-radius: 12px;
    transition:
        background 0.2s ease,
        transform 0.2s ease;
}

.cart-button:hover {
    background: var(--color-primary-dark);
    transform: translateY(-1px);
}

.cart-button svg {
    width: 19px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.cart-button__text {
    font-size: 0.8rem;
    font-weight: 700;
}

.cart-count {
    min-width: 21px;
    height: 21px;
    display: grid;
    place-items: center;
    color: var(--color-primary);
    background: #fff;
    border-radius: 20px;
    font-size: 0.7rem;
    font-weight: 800;
}

.menu-button {
    display: none;
    padding: 0;
}

.menu-button span {
    width: 19px;
    height: 2px;
    display: block;
    margin: 2.5px auto;
    background: #fff;
    border-radius: 10px;
    transition: 0.25s ease;
}

.menu-button.active span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
}

.menu-button.active span:nth-child(2) {
    opacity: 0;
}

.menu-button.active span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
}

.mobile-nav {
    display: none;
}

/* Buttons */

.button {
    min-height: 50px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 0 24px;
    border: 1px solid transparent;
    border-radius: 13px;
    font-size: 0.9rem;
    font-weight: 700;
    transition:
        transform 0.2s ease,
        background 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
}

.button svg {
    width: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.button--primary {
    color: #fff;
    background: var(--color-primary);
    box-shadow: 0 13px 30px rgba(239, 43, 45, 0.25);
}

.button--primary:hover {
    background: var(--color-primary-dark);
}

.button--ghost {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
    border-color: rgba(255, 255, 255, 0.16);
}

.button--ghost:hover {
    background: rgba(255, 255, 255, 0.1);
}

.button--dark {
    color: #fff;
    background: var(--color-dark);
}

.button--light {
    color: var(--color-dark);
    background: #fff;
}

.button--outline-light {
    color: #fff;
    border-color: rgba(255, 255, 255, 0.3);
}

/* Hero */

.hero {
    position: relative;
    min-height: 720px;
    display: flex;
    align-items: center;
    overflow: hidden;
    color: #fff;
    background:
        radial-gradient(circle at 80% 20%, rgba(239, 43, 45, 0.11), transparent 28%),
        linear-gradient(135deg, #0b0e13 0%, #111721 55%, #080a0e 100%);
}

.hero::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.08;
    pointer-events: none;
    background-image:
        linear-gradient(rgba(255,255,255,.18) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,.18) 1px, transparent 1px);
    background-size: 58px 58px;
    mask-image: linear-gradient(to left, #000, transparent 75%);
}

.hero__glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(15px);
    pointer-events: none;
}

.hero__glow--one {
    top: 15%;
    right: 55%;
    width: 350px;
    height: 350px;
    background: rgba(239, 43, 45, 0.05);
}

.hero__glow--two {
    left: -180px;
    bottom: -260px;
    width: 550px;
    height: 550px;
    border: 1px solid rgba(255, 255, 255, 0.06);
}

.hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    align-items: center;
    gap: 80px;
    padding-block: 80px;
}

.eyebrow {
    width: max-content;
    display: flex;
    align-items: center;
    gap: 9px;
    margin-bottom: 20px;
    padding: 7px 13px;
    color: #e8eaf0;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 40px;
    font-size: 0.75rem;
}

.eyebrow__icon {
    width: 20px;
    height: 20px;
    display: grid;
    place-items: center;
    color: #fff;
    background: var(--color-primary);
    border-radius: 50%;
    font-size: 0.65rem;
}

.hero h1 {
    max-width: 650px;
    margin: 0;
    font-size: clamp(3.2rem, 6vw, 5.5rem);
    line-height: 1.18;
    letter-spacing: -3px;
    font-weight: 900;
}

.hero h1 span {
    display: block;
    color: var(--color-primary);
}

.hero__description {
    max-width: 610px;
    margin: 24px 0 30px;
    color: #b7bdc8;
    font-size: 1.03rem;
    line-height: 2;
}

.hero-search {
    max-width: 630px;
    min-height: 65px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 6px 7px 6px 17px;
    color: #30343b;
    background: #fff;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 16px;
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.24);
}

.hero-search svg,
.product-search svg {
    width: 21px;
    flex: 0 0 auto;
    fill: none;
    stroke: #777d87;
    stroke-width: 1.8;
    stroke-linecap: round;
}

.hero-search input {
    min-width: 0;
    flex: 1;
    color: var(--color-text);
    background: transparent;
    border: 0;
    outline: 0;
}

.hero-search input::placeholder {
    color: #979ca5;
}

.hero-search button {
    min-width: 98px;
    align-self: stretch;
    color: #fff;
    background: var(--color-primary);
    border: 0;
    border-radius: 11px;
    font-size: 0.86rem;
    font-weight: 700;
}

.hero__suggestions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 11px;
    margin-top: 13px;
    color: #808793;
    font-size: 0.72rem;
}

.hero__suggestions button {
    padding: 0;
    color: #c4c8d0;
    background: none;
    border: 0;
}

.hero__suggestions button:hover {
    color: #fff;
}

.hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 31px;
}

.hero__metrics {
    max-width: 620px;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    margin-top: 43px;
    padding-top: 25px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
}

.hero__metrics div {
    display: flex;
    flex-direction: column;
}

.hero__metrics div + div {
    padding-right: 28px;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
}

.hero__metrics strong {
    font-size: 1.23rem;
    font-weight: 800;
}

.hero__metrics span {
    color: #8e96a2;
    font-size: 0.71rem;
}

.hero__visual {
    position: relative;
    min-height: 530px;
    display: grid;
    place-items: center;
}

.brake-stage {
    position: relative;
    width: min(470px, 100%);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
}

.tech-ring {
    position: absolute;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 50%;
}

.tech-ring--one {
    inset: 2%;
}

.tech-ring--two {
    inset: 14%;
    border-style: dashed;
    animation: rotateRing 35s linear infinite;
}

.brake-disc {
    position: relative;
    width: 68%;
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border: 3px solid #89909a;
    border-radius: 50%;
    background:
        radial-gradient(circle at center, #12161d 0 17%, transparent 17.5%),
        repeating-radial-gradient(circle at center, transparent 0 25%, rgba(255,255,255,.05) 25.5% 26%, transparent 26.5% 30%),
        conic-gradient(from 0deg, #777e88, #e3e6e9, #636a74, #bfc4c9, #6d747e, #ebedef, #777e88);
    box-shadow:
        0 35px 70px rgba(0, 0, 0, 0.45),
        inset 0 0 30px rgba(0, 0, 0, 0.45);
    animation: floatDisc 5s ease-in-out infinite;
}

.brake-disc::before {
    content: "";
    position: absolute;
    inset: 23%;
    border: 16px solid #4f5660;
    border-radius: 50%;
    box-shadow:
        inset 0 0 15px #11151a,
        0 0 0 2px #9197a0;
}

.brake-disc__inner {
    position: relative;
    z-index: 2;
    width: 21%;
    aspect-ratio: 1;
    border: 5px solid #848b94;
    border-radius: 50%;
    background: #12161c;
}

.disc-hole {
    position: absolute;
    width: 10px;
    height: 10px;
    background: #171b21;
    border-radius: 50%;
    box-shadow: inset 1px 1px 3px #000;
}

.disc-hole--1 { top: 12%; left: 49%; }
.disc-hole--2 { top: 25%; left: 21%; }
.disc-hole--3 { bottom: 25%; left: 18%; }
.disc-hole--4 { bottom: 11%; left: 51%; }
.disc-hole--5 { right: 19%; bottom: 26%; }
.disc-hole--6 { top: 24%; right: 18%; }

.caliper {
    position: absolute;
    z-index: 3;
    right: 4%;
    width: 31%;
    height: 49%;
    display: grid;
    place-items: center;
    color: rgba(255,255,255,.7);
    background: linear-gradient(145deg, #fb3739, #a6080c);
    border: 3px solid #ff5b5d;
    border-radius: 55% 30% 45% 50%;
    box-shadow:
        -15px 20px 40px rgba(0, 0, 0, 0.4),
        inset 8px 8px 18px rgba(255, 255, 255, 0.15);
    transform: rotate(-8deg);
}

.caliper span {
    font-size: 1.7rem;
    font-weight: 900;
    transform: rotate(90deg);
}

.visual-badge {
    position: absolute;
    z-index: 4;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 13px 17px;
    color: #fff;
    background: rgba(20, 25, 34, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 15px;
    box-shadow: var(--shadow-medium);
    backdrop-filter: blur(15px);
}

.visual-badge--top {
    top: 10%;
    left: -2%;
}

.visual-badge--bottom {
    right: 3%;
    bottom: 8%;
}

.visual-badge__icon {
    width: 35px;
    height: 35px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: #6cf0ad;
    background: rgba(35, 178, 109, 0.13);
    border-radius: 10px;
    font-weight: 800;
}

.visual-badge__icon--red {
    color: #ff7779;
    background: rgba(239, 43, 45, 0.13);
    font-size: 0.7rem;
}

.visual-badge div {
    display: flex;
    flex-direction: column;
}

.visual-badge strong {
    font-size: 0.77rem;
}

.visual-badge small {
    color: #9299a5;
    font-size: 0.62rem;
}

@keyframes floatDisc {
    0%, 100% {
        transform: translateY(0) rotate(-2deg);
    }
    50% {
        transform: translateY(-13px) rotate(2deg);
    }
}

@keyframes rotateRing {
    to {
        transform: rotate(360deg);
    }
}

/* Brand strip */

.brand-strip {
    background: #fff;
    border-bottom: 1px solid var(--color-border);
}

.brand-strip__inner {
    min-height: 95px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
}

.brand-strip__inner > span {
    color: #8b9099;
    font-size: 0.73rem;
    white-space: nowrap;
}

.brand-list {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 25px;
    color: #a3a7ae;
    font-size: 1rem;
    letter-spacing: 0.5px;
}

.brand-list strong {
    transition:
        color 0.2s ease,
        transform 0.2s ease;
}

.brand-list strong:hover {
    color: #4b5058;
    transform: translateY(-2px);
}

/* Sections */

.section {
    padding-block: 105px;
}

.section--muted {
    background: var(--color-background);
}

.section-heading {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 25px;
    margin-bottom: 40px;
}

.section-heading--center {
    justify-content: center;
    text-align: center;
}

.section-heading--center p {
    margin: 10px 0 0;
    color: var(--color-muted);
}

.section-label {
    display: block;
    margin-bottom: 8px;
    color: var(--color-primary);
    font-size: 0.76rem;
    font-weight: 800;
}

.section-heading h2,
.support-card h2,
.promo h2 {
    margin: 0;
    font-size: clamp(1.8rem, 3vw, 2.65rem);
    line-height: 1.4;
    letter-spacing: -1.2px;
}

.section-heading > a {
    display: flex;
    align-items: center;
    gap: 9px;
    color: var(--color-muted);
    font-size: 0.82rem;
    font-weight: 600;
}

.section-heading > a:hover {
    color: var(--color-primary);
}

/* Categories */

.category-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
}

.category-card {
    min-height: 126px;
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 21px;
    text-align: right;
    color: var(--color-text);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease,
        border-color 0.25s ease;
}

.category-card:hover {
    border-color: rgba(239, 43, 45, 0.3);
    box-shadow: var(--shadow-small);
    transform: translateY(-5px);
}

.category-card__icon {
    width: 51px;
    height: 51px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: var(--color-primary);
    background: rgba(239, 43, 45, 0.08);
    border-radius: 15px;
    font-size: 1.45rem;
}

.category-card > span:nth-child(2) {
    min-width: 0;
    display: flex;
    flex: 1;
    flex-direction: column;
}

.category-card strong {
    font-size: 0.96rem;
}

.category-card small {
    color: var(--color-muted);
    font-size: 0.67rem;
    white-space: nowrap;
}

.category-card__arrow {
    color: #a7abb3;
    font-size: 1.1rem;
}

/* Products */

.section-heading--products {
    align-items: center;
}

.product-search {
    width: min(100%, 340px);
    min-height: 47px;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 15px;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 12px;
}

.product-search svg {
    width: 18px;
}

.product-search input {
    width: 100%;
    background: transparent;
    border: 0;
    outline: 0;
    font-size: 0.8rem;
}

.filter-row {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 18px;
}

.filter-button {
    min-height: 41px;
    padding: 0 17px;
    color: #696e77;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: 11px;
    font-size: 0.76rem;
    font-weight: 600;
    transition: 0.2s ease;
}

.filter-button:hover,
.filter-button.active {
    color: #fff;
    background: var(--color-dark);
    border-color: var(--color-dark);
}

.results-meta {
    min-height: 30px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 14px;
    color: var(--color-muted);
    font-size: 0.73rem;
}

.results-meta button {
    padding: 0;
    color: var(--color-primary);
    background: none;
    border: 0;
    font-size: 0.73rem;
}

.product-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.product-card {
    position: relative;
    overflow: hidden;
    background: #fff;
    border: 1px solid #e1e3e7;
    border-radius: var(--radius-medium);
    transition:
        transform 0.25s ease,
        box-shadow 0.25s ease;
}

.product-card:hover {
    box-shadow: var(--shadow-medium);
    transform: translateY(-7px);
}

.product-card__visual {
    position: relative;
    height: 230px;
    display: grid;
    place-items: center;
    overflow: hidden;
    background:
        radial-gradient(circle at center, #fff, transparent 60%),
        linear-gradient(145deg, #f5f6f8, #e9ebef);
}

.product-card__visual::before {
    content: "";
    position: absolute;
    width: 170px;
    height: 170px;
    border: 1px solid rgba(14, 18, 25, 0.07);
    border-radius: 50%;
}

.product-card__visual svg {
    position: relative;
    z-index: 1;
    width: 160px;
    height: 160px;
    filter: drop-shadow(0 22px 19px rgba(12, 16, 22, 0.18));
    transition: transform 0.3s ease;
}

.product-card:hover .product-card__visual svg {
    transform: scale(1.06) rotate(-2deg);
}

.product-card__badge {
    position: absolute;
    z-index: 2;
    top: 13px;
    right: 13px;
    padding: 5px 10px;
    color: #fff;
    background: var(--color-primary);
    border-radius: 7px;
    font-size: 0.64rem;
    font-weight: 700;
}

.product-card__badge--dark {
    background: var(--color-dark);
}

.quick-view-button {
    position: absolute;
    z-index: 2;
    left: 13px;
    top: 13px;
    width: 37px;
    height: 37px;
    display: grid;
    place-items: center;
    color: var(--color-text);
    background: rgba(255,255,255,.88);
    border: 1px solid rgba(0,0,0,.06);
    border-radius: 10px;
    opacity: 0;
    transform: translateY(-7px);
    transition: 0.2s ease;
}

.product-card:hover .quick-view-button,
.quick-view-button:focus {
    opacity: 1;
    transform: translateY(0);
}

.quick-view-button svg {
    width: 18px;
    height: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    filter: none;
}

.product-card__content {
    padding: 18px;
}

.product-card__category {
    color: var(--color-primary);
    font-size: 0.65rem;
    font-weight: 700;
}

.product-card h3 {
    min-height: 51px;
    margin: 6px 0 8px;
    font-size: 0.93rem;
    line-height: 1.75;
}

.product-card__compatibility {
    min-height: 39px;
    margin: 0;
    color: var(--color-muted);
    font-size: 0.68rem;
    line-height: 1.7;
}

.product-card__rating {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 10px;
    color: var(--color-muted);
    font-size: 0.65rem;
}

.product-card__rating strong {
    color: var(--color-warning);
    letter-spacing: 1px;
}

.product-card__footer {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 10px;
    margin-top: 17px;
    padding-top: 15px;
    border-top: 1px solid #eceef1;
}

.product-price {
    display: flex;
    flex-direction: column;
}

.product-price del {
    min-height: 18px;
    color: #a4a8af;
    font-size: 0.64rem;
}

.product-price strong {
    font-size: 0.94rem;
    font-weight: 800;
}

.product-price strong small {
    font-size: 0.61rem;
    font-weight: 500;
}

.add-to-cart {
    width: 42px;
    height: 42px;
    display: grid;
    flex: 0 0 auto;
    place-items: center;
    color: #fff;
    background: var(--color-dark);
    border: 0;
    border-radius: 11px;
    transition: 0.2s ease;
}

.add-to-cart:hover {
    background: var(--color-primary);
}

.add-to-cart svg {
    width: 18px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
}

.empty-state {
    padding: 80px 20px;
    text-align: center;
    background: #fff;
    border: 1px dashed #d5d8de;
    border-radius: var(--radius-medium);
}

.empty-state > span {
    color: #c0c4cb;
    font-size: 4rem;
}

.empty-state h3 {
    margin: 0;
}

.empty-state p {
    margin: 5px 0 25px;
    color: var(--color-muted);
}

/* Benefits */

.benefits-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 18px;
}

.benefit-card {
    position: relative;
    min-height: 280px;
    padding: 28px;
    overflow: hidden;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    transition:
        transform 0.25s ease,
        border-color 0.25s ease;
}

.benefit-card:hover {
    border-color: rgba(239, 43, 45, 0.32);
    transform: translateY(-5px);
}

.benefit-card__number {
    position: absolute;
    top: 9px;
    left: 20px;
    color: #f0f1f3;
    font-size: 3.6rem;
    font-weight: 900;
}

.benefit-card__icon {
    position: relative;
    z-index: 1;
    width: 50px;
    height: 50px;
    display: grid;
    place-items: center;
    color: var(--color-primary);
    background: rgba(239, 43, 45, 0.08);
    border-radius: 14px;
    font-size: 1.2rem;
    font-weight: 800;
}

.benefit-card h3 {
    margin: 28px 0 10px;
    font-size: 1rem;
}

.benefit-card p {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.76rem;
    line-height: 2;
}

/* Promo */

.promo {
    color: #fff;
    background: var(--color-primary);
}

.promo__inner {
    position: relative;
    min-height: 360px;
    display: grid;
    grid-template-columns: 1.25fr 0.75fr;
    align-items: center;
    gap: 60px;
    overflow: hidden;
}

.promo__inner::before {
    content: "";
    position: absolute;
    left: -100px;
    width: 470px;
    height: 470px;
    border: 70px solid rgba(255, 255, 255, 0.06);
    border-radius: 50%;
}

.promo__content,
.promo__code {
    position: relative;
    z-index: 1;
}

.promo__label {
    display: block;
    margin-bottom: 8px;
    color: rgba(255,255,255,.8);
    font-size: 0.75rem;
    font-weight: 700;
}

.promo p {
    max-width: 680px;
    margin: 15px 0 25px;
    color: rgba(255,255,255,.82);
    font-size: 0.88rem;
}

.promo__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
}

